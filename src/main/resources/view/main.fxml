<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainPane" xmlns="http://javafx.com/javafx/21.0.8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="todoList.controller.MainController">
   <center>
      <VBox alignment="TOP_CENTER" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label id="title" text="To Do List" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" fillHeight="false" spacing="20.0">
               <children>
                  <TextField fx:id="newTaskField" onAction="#addTask" prefHeight="40.0" prefWidth="340.0" promptText="Adicionar nova tarefa" HBox.hgrow="ALWAYS" />
                  <Button fx:id="addButton" alignment="CENTER" mnemonicParsing="false" onAction="#addTask" text="+" />
               </children>
            </HBox>
            <ScrollPane hbarPolicy="NEVER" prefHeight="350.0" prefWidth="430.0">
               <content>
                  <VBox fx:id="taskList" spacing="10.0" />
               </content>
            </ScrollPane>
         </children>
         <padding>
            <Insets left="30.0" right="30.0" />
         </padding>
         <BorderPane.margin>
            <Insets bottom="30.0" top="30.0" />
         </BorderPane.margin>
      </VBox>
   </center>
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="Configurações">
            <items>
                  <CheckMenuItem fx:id="switchModeButton" mnemonicParsing="false" onAction="#switchMode" text="Modo escuro" />
                  <MenuItem fx:id="configButton" mnemonicParsing="false" onAction="#showConfig" text="Alterar diretório" />
                  <MenuItem fx:id="colorButton" mnemonicParsing="false" onAction="#changeColor" text="Alterar cor" />
            </items>
          </Menu>
            <Menu mnemonicParsing="false" text="Sobre">
               <items>
                  <MenuItem fx:id="githubButton" mnemonicParsing="false" onAction="#openGithub" text="Github" />
                  <MenuItem fx:id="linkedinButton" mnemonicParsing="false" onAction="#openLinkedin" text="Linkedin" />
               </items>
            </Menu>
        </menus>
      </MenuBar>
   </top>
</BorderPane>
